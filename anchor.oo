// # oocron Root Verification Anchor
//
// Logline: Unified test runner aggregating verification anchors from core, render, and ipc subsystems.
//
// Setup: Demands no ambient authority; invokes deterministic subsystem test routines.
//
// Beats:
//   1. Execute core cron parsing, validation, and systemd unit generation checks.
//   2. Execute render theme palettes, view layouts, and JSON serialization tests.
//   3. Execute ipc CLI argument parsing and MCP protocol tests.
//   4. Return aggregate boolean test result.

import "core/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

pub fn run_all_tests() -> Bool {
    if !run_core_tests() {
        return false;
    }
    if !run_render_tests() {
        return false;
    }
    if !run_ipc_tests() {
        return false;
    }
    return true;
}
