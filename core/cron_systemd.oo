// # oocron Systemd Unit Synthesizer
//
// Logline: Generates hardened systemd timer and service unit configurations from parsed cron schedules.
//
// Setup: Strictly follows pure systemd-native architectural guidelines from GEMINI.md.
//
// Beats:
//   1. Synthesize declarative .timer units with OnCalendar and Persistent directives.
//   2. Synthesize hardened oneshot .service units with ProtectSystem, PrivateTmp, and NoNewPrivileges.
//   3. Wire logging exclusively to systemd-journald.
//   4. Package complete SystemdUnitPair record with standardized unit filesystem paths.

import "core/cron_types.oo";
import "core/cron_parser.oo";

pub fn generate_timer_unit(sched: CronSchedule, unit_name: String) -> String {
    let mut out: String = "# Generated by oocron - pure systemd timer scheduler\n";
    out = out + "[Unit]\n";
    out = out + "Description=oocron scheduled timer: " + unit_name + "\n";
    out = out + "Documentation=man:systemd.timer(5)\n";
    out = out + "Requires=" + unit_name + ".service\n\n";

    out = out + "[Timer]\n";
    if sched.is_macro && sched.raw_expr == "@reboot" {
        out = out + "OnBootSec=1m\n";
    } else {
        out = out + "OnCalendar=" + sched.systemd_calendar + "\n";
        out = out + "Persistent=true\n";
    }
    out = out + "AccuracySec=1s\n\n";

    out = out + "[Install]\n";
    out = out + "WantedBy=timers.target\n";
    return out;
}

pub fn generate_service_unit(command: String, unit_name: String) -> String {
    let mut out: String = "# Generated by oocron - hardened oneshot systemd service\n";
    out = out + "[Unit]\n";
    out = out + "Description=oocron scheduled execution: " + unit_name + "\n";
    out = out + "Documentation=man:systemd.service(5)\n";
    out = out + "RefuseManualStart=no\n\n";

    out = out + "[Service]\n";
    out = out + "Type=oneshot\n";
    out = out + "ExecStart=" + command + "\n";

    // GEMINI.md Confinement & Hardening:
    out = out + "ProtectSystem=strict\n";
    out = out + "ProtectHome=read-only\n";
    out = out + "PrivateTmp=true\n";
    out = out + "NoNewPrivileges=true\n";

    // GEMINI.md Logging: Handled exclusively by systemd-journald
    out = out + "StandardOutput=journal\n";
    out = out + "StandardError=journal\n";
    return out;
}

pub fn transpile_cron_to_systemd(
    expr: String,
    command: String,
    unit_name: String
) -> SystemdUnitPair {
    let sched: CronSchedule = parse_cron_expression(expr);
    let timer: String = generate_timer_unit(sched, unit_name);
    let service: String = generate_service_unit(command, unit_name);

    return SystemdUnitPair {
        name: unit_name,
        timer_content: timer,
        service_content: service,
        timer_path: "/etc/systemd/system/" + unit_name + ".timer",
        service_path: "/etc/systemd/system/" + unit_name + ".service"
    };
}
